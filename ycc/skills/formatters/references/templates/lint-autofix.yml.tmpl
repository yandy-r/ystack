name: Lint autofix

on:
  pull_request:
    branches: [{{DEFAULT_BRANCH}}]

permissions:
  contents: read

concurrency:
  group: lint-autofix-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

jobs:
  format-and-push:
    name: Format and push fixes
    # Fork PRs cannot be pushed back to; the check workflow (lint.yml) still runs authoritatively.
    if: github.event.pull_request.head.repo.full_name == github.repository
    runs-on: ubuntu-latest
    env:
      # 'true' once the autofix App is configured for this repository (see the mint step).
      AUTOFIX_APP_CONFIGURED: ${{ vars.AUTOFIX_APP_CLIENT_ID != '' && secrets.AUTOFIX_APP_PRIVATE_KEY != '' }}
    steps:
      - name: Checkout PR head branch
        uses: actions/checkout@v4
        with:
          ref: ${{ github.head_ref }}
          fetch-depth: 0
          persist-credentials: false

{{#IF_RUST}}
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@v2
{{/IF_RUST}}

{{#IF_GO}}
      - uses: actions/setup-go@v5
        with:
          go-version: stable
          cache: true
{{/IF_GO}}

{{#IF_TS}}
      - uses: actions/setup-node@v4
        with:
          node-version: lts/*
          cache: npm
      - run: npm ci --no-audit --no-fund
{{/IF_TS}}

{{#IF_PYTHON}}
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install --no-cache-dir ruff black
{{/IF_PYTHON}}

{{#IF_SHELL}}
      - name: Install shellcheck
        run: ./scripts/install-shellcheck.sh
{{/IF_SHELL}}

{{#IF_DOCS}}
      - uses: actions/setup-node@v4
        with:
          node-version: lts/*
{{/IF_DOCS}}

      - name: Apply formatters
        run: ./scripts/style.sh format

      - name: Apply auto-fixable lint
        # Unfixable violations are reported by the check workflow (lint.yml); do not block the push-back here.
        run: ./scripts/style.sh lint --fix
        continue-on-error: true

      - name: Mint autofix App token
        id: app-token
        # A push made with GITHUB_TOKEN leaves every check on the autofix commit waiting for
        # approval, so the push uses a GitHub App token, minted only after the formatters ran.
        # Without the App variable and secret (or if minting fails) the job reports, not pushes.
        if: env.AUTOFIX_APP_CONFIGURED == 'true'
        continue-on-error: true
        uses: actions/create-github-app-token@v3
        with:
          client-id: ${{ vars.AUTOFIX_APP_CLIENT_ID }}
          private-key: ${{ secrets.AUTOFIX_APP_PRIVATE_KEY }}
          permission-contents: write

      - name: Commit and push if changed
        env:
          PR_HEAD_REF: ${{ github.head_ref }}
          AUTOFIX_SUBJECT: "chore: apply format + lint --fix (autofix workflow)"
          AUTOFIX_TOKEN: ${{ steps.app-token.outputs.token }}
          HAS_APP_TOKEN: ${{ steps.app-token.outputs.token != '' }}
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          if git diff --quiet && git diff --cached --quiet; then
            echo "No autofix changes."
            exit 0
          fi
          # Customize exclusions here, e.g.:
          #   git add -u -- . ':(exclude)CHANGELOG.md' ':(exclude)docs/internal/**'
          git add -u -- .
          if git diff --cached --quiet; then
            echo "No autofix changes remain after exclusions."
            exit 0
          fi
          if [[ "$HAS_APP_TOKEN" != "true" ]]; then
            echo "::warning title=Lint autofix not pushed::Fixes found but not pushed: set the AUTOFIX_APP_CLIENT_ID variable and AUTOFIX_APP_PRIVATE_KEY secret (or check the App installation)."
            {
              echo "### Lint autofix: fixes found, not pushed"
              echo
              echo "This workflow pushes with a GitHub App token. Set the \`AUTOFIX_APP_CLIENT_ID\` variable and \`AUTOFIX_APP_PRIVATE_KEY\` secret, or run the formatters locally."
              echo
              echo '```'
              git diff --cached --stat
              echo '```'
            } >> "$GITHUB_STEP_SUMMARY"
            exit 0
          fi
          # Loop guard: the App push starts a new run on the autofix commit. If HEAD is already
          # that commit and the fixers still change files, they are not idempotent; stop here.
          if [[ "$(git log -1 --format=%s)" == "$AUTOFIX_SUBJECT" ]]; then
            echo "::warning title=Lint autofix stopped::HEAD is already an autofix commit and the fixers still change files; not pushing again."
            git diff --cached --stat
            exit 0
          fi
          git commit -m "$AUTOFIX_SUBJECT"
          git push "https://x-access-token:${AUTOFIX_TOKEN}@${GITHUB_SERVER_URL#https://}/${GITHUB_REPOSITORY}.git" "HEAD:${PR_HEAD_REF}"
