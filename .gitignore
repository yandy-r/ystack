# macOS
.DS_Store

# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local

# Logs
*.log

# Temporary files
*.tmp
*.swp
*~

# CLAUDE
/.claude/settings.local.json

# IDE
.idea/
.vscode/
*.sublime-*

# Pinned tooling (scripts/install-shellcheck.sh installs repo-local shellcheck here)
/tools/shellcheck

# Python
__pycache__/
*.py[cod]
.mypy_cache/
# pyproject.toml is tool config only (no [project]); `uv run` — including the
# lefthook hook fallback when lefthook is not installed — writes these locally.
/uv.lock
/.venv/

# opencode model-alias overrides (per-user, optional)
scripts/opencode_model_aliases.local.json

# Agent-Native visual-plan/visual-recap local scratch
plan-blocks.md
**/plans/*/.plan-serve/
**/.agent-native/
.config/opencode/
opencode.json

# Agent-managed git worktrees (per-runtime repo-local roots, YAN-1111, YAN-1170)
.claude/worktrees/
.opencode/worktrees/
.codex/worktrees/
.cursor/worktrees/
.omp/worktrees/
.agents/worktrees/

.slim/deepwork/

# graphify knowledge-graph output (local scratch)
graphify-out/

# claude plugin eval results (paid local runs)
ycc/evals/results/
ycc/evals-quarantine/results/
.omp/**
