#compdef ycc
# zsh completion for ycc (install.sh) — install: ycc completion --shell zsh --install

# _ycc_list_names <kind> — a kind's names, from 'ycc list <kind>' for the --target on the line.
# The kind is the last argument: _arguments prepends options such as '-J -default-'.
_ycc_list_names() {
    local kind="${@[-1]}" targets="all" i
    for (( i = 1; i < CURRENT; i++ )); do
        [[ "${words[i]}" == "--target" ]] && targets="${words[i+1]}"
    done
    local -a names
    names=(${(f)"$(${_ycc_cmd} list "${kind}" --target "${targets}" 2>/dev/null)"})
    (( ${#names} )) && _values -s , "${kind}" "${names[@]}"
}

_ycc() {
    local _ycc_cmd="${words[1]}"
    local -a common kinds selectors install_selectors
    common=(
        '--target[targets to sync]:targets:_values -s , target claude cursor codex opencode agents omp all'
        '(--global)--project[write into the current project]'
        '(--project)--global[write into user-global config]'
        '--force[let repo values win]'
        '--dry-run[preview without writing]'
        '--help[show help]'
    )
    local mode='--mode[marketplace source mode]:mode:(local repo)'
    local intent='--intent[what to sync]:intents:_values -s , intent base skills agents commands settings rules mcp hooks plugins mods'
    local only='--only[run only these steps]:steps:_values -s , step base dedupe skills agents settings rules mcp hooks mods'
    local package='--package[install package closures]:packages:_values -s , package ycc ycc-mcp ycc-hooks ycc-rules ycc-all'
    local list_target='--target[targets to list for]:targets:_values -s , target claude cursor codex opencode agents omp all'
    # --<kind> selectors: one per kind from 'ycc list', names from 'ycc list <kind>'.
    local kind
    kinds=(${(f)"$(${_ycc_cmd} list 2>/dev/null)"})
    for kind in "${kinds[@]}"; do
        selectors+=("--${kind}[only these ${kind}]:${kind}:_ycc_list_names ${kind}")
    done

    if (( CURRENT == 2 )); then
        local -a subcommands
        subcommands=(
            'install:initial setup (base + opt-in steps)'
            'sync:sync intents to targets'
            'remove:remove installer-managed config'
            'cli:link install.sh onto PATH as ycc'
            'completion:print or install shell completion'
            'list:list selectable kinds or a kind'"'"'s names'
        )
        _describe -t commands 'ycc command' subcommands
        return
    fi

    # Hand _arguments the words after the subcommand.
    local sub="${words[2]}"
    shift words
    (( CURRENT-- ))
    case "${sub}" in
        cli)
            _arguments '--dir[install directory]:directory:_directories' '--force[replace existing]' '--help[show help]'
            ;;
        list)
            _arguments "1:kind:(${kinds[*]})" "${list_target}" '--help[show help]'
            ;;
        completion)
            _arguments '--shell[shell]:shell:(bash zsh fish)' '--install[install for the shell]' '--force[replace existing]' '--help[show help]'
            ;;
        install)
            _arguments "${common[@]}" "${mode}" "${package}" "${only}" "${selectors[@]}" \
                '--settings[also run the settings step]' '--rules[also run the rules step]' \
                '--mcp[also run the mcp step]' '--hooks[also run the hooks step]' \
                '--with-deps[also select ycc dependencies of --skills]'
            ;;
        sync)
            _arguments "${common[@]}" "${mode}" "${intent}" "${selectors[@]}" \
                '--with-deps[also select ycc dependencies of --skills]'
            ;;
        remove)
            _arguments "${common[@]}" "${only}" "${intent}" "${selectors[@]}" \
                '--purge-cache[also delete the opencode package cache of removed catalog plugins]'
            ;;
    esac
}

if [[ "${funcstack[1]}" == "_ycc" ]]; then
    _ycc "$@"
else
    compdef _ycc ycc
fi
